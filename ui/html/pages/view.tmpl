{{define "title"}}Snippet #{{.Snippet.ID}}{{end}}

{{define "main"}}
{{with .Snippet}}
<div class='snippet'>
    <div class='metadata'>
        <strong>{{.Title}}</strong>
        <span>#{{.ID}}</span>
    </div>

    <pre><code>{{.Content}}</code></pre>

    <div class='metadata'>
        <time>Created: {{humanDate .Created}}</time>
        <time>Expires: {{humanDate .Expires}}</time>
    </div>

    {{if $.IsAuthenticated}}
    <div class='actions'>

        <form action='/snippet/delete/{{.ID}}' method='POST' class='delete-form'>
            <input type='hidden' name='csrf_token' value='{{$.CSRFToken}}'>
            <button type='submit' class='delete-button'>Delete</button>
        </form>

        <a href='/snippet/edit/{{.ID}}' class='update-button'>Update</a>

    </div>

    <dialog id='delete-dialog'>
        <p>Точно хотите удалить эту запись?</p>

        <button type='button' id='dialog-cancel-btn'>Отмена</button>
        <button type='button' id='dialog-confirm-btn'>Удалить</button>
    </dialog>
    {{end}}
</div>
{{end}}
{{end}}